                                // stage('Gateway Api: Query') {
                                //     catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                //         sh "npm run queryApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT} --reporter mochawesome --reporter-options reportDir=reportDir,reportFilename=queryApiReport;"
