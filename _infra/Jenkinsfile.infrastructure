pipeline {
  environment {
    avn_connector_path = "avn-connector"
    region             = "eu-west-1"
  }

  parameters {
    choice(name: 'environment', choices: ['sandbox', 'cba'], description: 'Chose the environment to deploy to.')
    choice(name: 'terraform_target', choices: ['none', 'all', 'lambda_functions', 'eks', 'api-gateway', 'vpc', 'k8s_service_account_permissions', 'rabbitmq', "bastion", "avn-vault"], description: 'Apply specific terraform module targets.')
    string(name: 'additional_terraform_args', defaultValue: '', description: 'Supply additional terraform arguments, The environment can be destroyed by supplying the arg -destroy', trim: true)
    choice(name: 'apply_third_party_charts', choices: ['false', 'true'], description: 'Apply third party helm charts to kubernetes')
    choice(name: 'new_environment', choices: ['false', 'true'], description: 'Apply a new environment, if true then the VPC will be built before the rest of the infrastructure.')
  }

  agent any

  stages {
    stage("Initialise VPC plan") {
      when {
        expression {
            return env.new_environment == 'true';
        }
      }
      steps {
        dir("_infra/terraform/environments/${env.environment}") {
          sh "terraform init"
          sh "terraform plan -target module.vpc -target module.redis -out=plan-out-vpc.tfplan -no-color"
        }
      }
    }

    stage("Apply VPC") {
      when {
        beforeInput true
        expression {
            return env.new_environment == 'true';
        }
      }
      input {
        message "Proceed with VPC apply"
      }
      steps {
        dir("_infra/terraform/environments/${env.environment}") {
          sh "terraform init"
          sh "terraform apply plan-out-vpc.tfplan -no-color"
        }
      }
    }

    stage("Terraform plan") {
      when {
        expression {
            return env.terraform_target != 'none';
        }
      }
      steps {
        sshagent(credentials: ['fb69386f-f549-4276-95d2-94f34fc063ad', 'aws-dev-ssh']) {
          dir("_infra/terraform/environments/${env.environment}") {
            terraformPlan()
          }
        }
      }
    }

    stage("Terraform Apply") {
      when {
        beforeInput true
        expression {
            return env.terraform_target != 'none';
        }
      }
      input {
        message "Proceed with Terraform apply"
      }
      steps {
        sshagent(credentials: ['fb69386f-f549-4276-95d2-94f34fc063ad', 'aws-dev-ssh']) {
          dir("_infra/terraform/environments/${env.environment}") {
            terraformApply()
          }
        }
      }
    }

    stage("Get Terraform outputs") {
      when {
        expression {
            return env.additional_terraform_args != '-destroy';
        }
      }
      steps {
        sshagent(credentials: ['fb69386f-f549-4276-95d2-94f34fc063ad', 'aws-dev-ssh']) {
          dir("_infra/terraform/environments/${env.environment}") {
            sh "terraform init"
            script {
              avn_connector_ips = terraformOutput("avn_connector_ips")
              private_subnets = terraformOutput("main_subnet")
              private_hosted_zone_id = terraformOutput("private_hosted_zone_id")
              redis_security_group_id = terraformOutput("redis_security_group_id")
              redis_password = terraformOutput("redis_password")
              redis_username = terraformOutput("redis_username")
            }
          }
        }
      }
    }

    stage("Deploy Redis cluster") {
      when {
        expression {
          return env.new_environment == 'true';
        }
      }
      steps {
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          sh "aws memorydb create-subnet-group --region ${env.region} --subnet-group-name redis --subnet-ids ${subnets(private_subnets)}";
          sh "aws memorydb create-user --region ${env.region} --user-name ${redis_username} \
            --authentication-mode Type=password,Passwords=\\\"${redis_password}\\\" \
            --access-string on \
            --access-string ~* \
            --access-string \\&* \
            --access-string +@all"
          sh "aws memorydb create-acl --acl-name avn-connector --region ${env.region} --user-names ${redis_username}"
          sh "aws memorydb create-cluster --cluster-name avn-connector --node-type db.r6g.large \
            --subnet-group redis \
            --security-group-ids ${redis_security_group_id} \
            --no-tls-enabled \
            --snapshot-retention-limit 30 \
            --num-shards 1 --num-replicas-per-shard 2 \
            --acl-name open-access \
            --region ${env.region}"
        }
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          script {
            redis_address = redisAddress()
            while (!redis_address?.trim()) {
              echo "MemoryDB cluster is being created sleeping for 10 seconds . . ."
              redis_address = redisAddress()
            }
          }
        }
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          sh "aws route53 change-resource-record-sets \
              --hosted-zone-id ${private_hosted_zone_id} \
              --change-batch ' \
              { \
                \"Comment\": \"Redis record\", \
                \"Changes\": [{ \
                  \"Action\"              : \"UPSERT\", \
                  \"ResourceRecordSet\"  : { \
                    \"Name\"              : \"redis.${env.environment}.aventus.internal\", \
                    \"Type\"             : \"CNAME\", \
                    \"TTL\"              : 120, \
                    \"ResourceRecords\"  : [{ \
                        \"Value\"         : \"'${redis_address}'\" \
                    }] \
                  } \
                }] \
              } \
              '"
        }
      }
    }
    
    stage("Deploy third party helm charts") {
      when {
        expression {
            return env.apply_third_party_charts == 'true' && env.additional_terraform_args != '-destroy';
        }
      }
      steps {
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          generateContext("avn-gateway", "kube-system")
          helmInstallThirdParty("aws-lb-controller")
          helmInstallThirdParty("external-secrets-manager")
        }
      }
    }

    stage("Deploy avn-connector") {
      when {
        expression {
            return env.additional_terraform_args != '-destroy';
        }
      }
      steps {
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          generateContext("avn-gateway", "dev")
          sh "kubectl create ns dev || true"
          sh "helm template ${env.avn_connector_path}/chart --set environment=${env.environment} --set accountId=${accountId()} --set service.subnetIds={${private_subnets}} --set service.privateIps={${avn_connector_ips}} | kubectl apply -f -"
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}

def generateContext(String clusterName, String namespace) {
  def id = accountId()
  sh "aws eks --region eu-west-1 update-kubeconfig --name ${clusterName}"
  sh "kubectl config set-context arn:aws:eks:eu-west-1:${id}:cluster/${clusterName} --namespace ${namespace}"
  sh "kubectl config use-context arn:aws:eks:eu-west-1:${id}:cluster/${clusterName}"
}

def terraformPlan() {
  sh "terraform init"
  if ( env.terraform_target == 'all' ) {
    sh "terraform plan -out=plan-out.tfplan -no-color ${env.additional_terraform_args}"
  } else {
    sh "terraform plan -target module.${env.terraform_target} -out=plan-out.tfplan -no-color ${env.additional_terraform_args}"
  }
}

def terraformApply() {
  sh "terraform init"
  sh "terraform apply plan-out.tfplan -no-color"
}

def accountId() {
  def environmentMap = [
    sandbox: "352429414196",
    cba: "602004642405"
  ]
  return environmentMap[env.environment]
}

def helmInstallThirdParty(String application) {
  sh "helm dep up _infra/cluster/${application}"
  sh "helm upgrade --install ${application} _infra/cluster/${application} --wait"
}

def terraformOutput(String outputName) {
  return sh(
    script: "terraform output -raw ${outputName}",
    returnStdout: true
  ).trim()
}

def subnets(String subnetStringList) {
  return subnetStringList.replaceAll(",", " ")
}

def redisAddress() {
  return sh(
    script: "aws memorydb describe-clusters --region eu-west-1 | jq -r 'select(.Clusters[0].ClusterEndpoint.Address != null) | .Clusters[0].ClusterEndpoint.Address'",
    returnStdout: true
  ).trim()
}