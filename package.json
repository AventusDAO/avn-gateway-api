{
  "scripts": {
    "slack": "node ./avn-api/slackServices/slackNotifications.js --gateway",
    "upload": "node ./avn-api/googleServices/nodeIndex.js --gateway",
    "smokeTests": "mocha --timeout 100000 ./tests/gateway-smoke-tests.js ${baselineCmd} --gateway",
    "smokeTests:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run smokeTests",
    "apiTests": "mocha --timeout 10000000 'avn-api/tests/apiTests.js' --delay ${baselineCmd} --gateway",
    "apiTests:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run apiTests",
    "solo": "mocha --timeout 100000 ",
    "pretty": "prettier --config ./.prettierrc.json --check \"**/*.{js,json}\"",
    "pretty:fix": "prettier --config ./.prettierrc.json --write \"**/*.{js,json}\"",
    "format": "npm run pretty:fix",
    "generateState": "./avn-api/tools/baseStateGenerator.js --gateway",
    "fund": "mocha --timeout 100000 ./avn-api/tests/accountFunding.js --gateway",
    "accessTests": "mocha --exit --timeout 10000000 'avn-api/tests/accessTests.js' ${baselineCmd} --gateway",
    "accessTests:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run accessTests --",
    "awtTest": "mocha --exit --timeout 10000000 'avn-api/tests/awtTest.js' ${baselineCmd} --gateway",
    "awtTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run awtTest --",
    "utilsTest": "mocha --exit --timeout 10000000 'avn-api/tests/utilsTest.js' ${baselineCmd} --gateway",
    "utilsTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run utilsTest --",
    "pollApiTest": "mocha --exit --timeout 10000000 'avn-api/tests/pollApiTest.js' ${baselineCmd} --gateway",
    "pollApiTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run pollApiTest --",
    "proxyApiTest": "mocha --exit --timeout 10000000 'avn-api/tests/proxyApiTest.js' ${baselineCmd} --gateway",
    "proxyApiTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run proxyApiTest --",
    "queryApiTest": "mocha --exit --timeout 10000000 'avn-api/tests/queryApiTest.js' ${baselineCmd} --gateway",
    "queryApiTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run queryApiTest --",
    "sendApiTest": "mocha --exit --timeout 10000000 'avn-api/tests/sendApiTest.js' ${baselineCmd} --gateway",
    "sendApiTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run sendApiTest --",
    "failPollApiTest": "mocha --exit --timeout 10000000 'avn-api/tests/failPollApiTest.js' --delay ${baselineCmd} --gateway",
    "failPollApiTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run failPollApiTest --",
    "failQueryApiTests": "mocha --exit --timeout 10000000 'avn-api/tests/failQueryApiTests.js' --delay ${baselineCmd} --gateway",
    "failQueryApiTests:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run failQueryApiTests --",
    "failSendApiTest": "mocha --exit --timeout 10000000 'avn-api/tests/failSendApiTest.js' --delay ${baselineCmd} --gateway",
    "failSendApiTest:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run failSendApiTest --"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "chai-as-promised": "7.1.1",
    "colors": "^1.4.0",
    "mocha": "^9.0.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.2.1",
    "prompt-sync": "^4.1.6",
    "serverless": "^3.1.1",
    "yargs": "^17.3.1"
  },
