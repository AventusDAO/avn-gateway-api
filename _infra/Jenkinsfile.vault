pipeline {
  environment {
    ANSIBLE_HOST_KEY_CHECKING="False"
    gpg_key_id="eosprod@aventus.io"
    region = "eu-west-1"
  }

  parameters {
    booleanParam( defaultValue: false, description: 'Whether or not deploy the instance of vault', name: 'deploy')
    booleanParam( defaultValue: false, description: 'Attempt to initialise the instance of vault', name: 'vault_init')
    booleanParam( defaultValue: false, description: 'Attempt to setup avn-vault module and application roles', name: 'setup_avn_vault')
    choice(name: 'gateway_environment', choices: ['cba', 'pentest', 'testnet', 'mainnet'], description: 'Deploy to which environment?')
  }

  agent any

  stages {

    stage("Checkout codebase") {
      steps {
        checkout([
            $class: 'GitSCM',
            branches: [[name: 'refs/heads/main']],
            doGenerateSubmoduleConfigurations: false,
            extensions: [[$class: 'CleanCheckout']],
            submoduleCfg: [],
            userRemoteConfigs: [[credentialsId: 'aventus-ci-agent', url: 'https://github.com/Aventus-Network-Services/avn-gateway-api.git']]
        ])
      }
    }

    stage("Deploy Vault & avn-vault files via ansible.") {
      when {
        expression {
            env.deploy == 'true' || env.vault_init == 'true' || env.setup_avn_vault == 'true'
        }
      }

      steps {
        sshagent(credentials: ['fb69386f-f549-4276-95d2-94f34fc063ad', 'technical-account-vault']) {
          // Generate the inventory file for the environment
          dir("${WORKSPACE}/_infra/terraform/environments/${env.gateway_environment}/gateway") {
            sh "terraform init && terraform apply -target local_file.avn-gateway-vault-instance-file -auto-approve"
          }

          dir("${WORKSPACE}/_infra/ansible") {
            // TODO use nexus to download the binaries.
            sh "cp -r /var/tmp/pipeline-files/vault-gateway-files/* ."

            // Install dependencies
            sh "ansible-galaxy install -r roles/requirements.yml -f"

            withCredentials([
              file(credentialsId: 'vault_tls_key_cba', variable: 'vault_tls_key_cba'),
              file(credentialsId: 'vault_tls_key_pentest', variable: 'vault_tls_key_pentest'),
              file(credentialsId: 'vault_tls_key_testnet', variable: 'vault_tls_key_testnet'),
              file(credentialsId: 'vault_tls_key_mainnet', variable: 'vault_tls_key_mainnet')
            ])
            {
              script {
                switch(env.gateway_environment) {
                  case 'cba':
                    vault_tls_key = '$vault_tls_key_cba'
                    break
                  case 'pentest':
                    vault_tls_key = '$vault_tls_key_pentest'
                    break
                  case 'testnet':
                    vault_tls_key = '$vault_tls_key_testnet'
                    break
                  case 'mainnet':
                    vault_tls_key = '$vault_tls_key_mainnet'
                    break
                }
                def gpg_public_key = sh(script: 'gpg --export ${gpg_key_id} | base64 -w 0', returnStdout: true)
                sh "ansible-playbook -v playbook-vault.yaml -i ${WORKSPACE}/_infra/terraform/environments/${env.gateway_environment}/gateway/vault.inventory --extra-vars \"{'vault_environment':'${env.gateway_environment}', 'tls_key_file':'${vault_tls_key}', 'root_gpg_public_key':'${gpg_public_key}', 'gpg_key_id':'${gpg_key_id}', 'deploy_vault': ${env.deploy}, 'init_vault': ${env.vault_init}, 'setup_avn_vault': ${env.setup_avn_vault} }\""
              }
            }
          }
        }
      }
    }
    stage("Store app-role and secret-id in secrets manager") {
      when {
        expression {
            env.setup_avn_vault == 'true'
        }
      }

      steps {
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          sh "gpg --output _infra/ansible/config.json --decrypt _infra/ansible/avn-vault-config.json.gpg"
          sh "aws secretsmanager put-secret-value --region ${env.region} --secret-id vault --secret-string file://_infra/ansible/config.json";
          sh "rm _infra/ansible/config.json"
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: '_infra/ansible/init.json,_infra/ansible/avn-vault-config.json.gpg,_infra/ansible/avn-vault-config.yaml.gpg', allowEmptyArchive: true
      cleanWs()
    }
  }
}

def accountId() {
  def environmentMap = [
    sandbox: "352429414196",
    cba: "602004642405",
    testnet: "189013141504",
    mainnet: "503742778456",
    pentest: "791662239430"
  ]
  return environmentMap[env.gateway_environment]
}
