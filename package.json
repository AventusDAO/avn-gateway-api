{
  "scripts": {
    "soloTests": "mocha --timeout 100000",
    "smokeTests": "mocha --timeout 100000 ./tests/gateway-smoke-tests.js",
    "apiTests": "mocha --timeout 100000 ./avn-api/tests --recursive",
    "allTestsSandbox": "npm run apiTests sandbox",
    "allTestsCBA": "npm run apiTests cba",
    "pretty": "prettier --config ./.prettierrc.json --check \"**/*.{js,json}\"",
    "pretty:fix": "prettier --config ./.prettierrc.json --write \"**/*.{js,json}\"",
    "format": "npm run pretty:fix"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "chai-as-promised": "7.1.1",
    "mocha": "^9.0.2",
    "serverless": "^2.70.0",
    "prompt-sync": "^4.2.0"
  },
  "dependencies": {
    "child-process-async": "^1.0.1",
    "colors": "^1.4.0",
    "prettier": "^2.5.1"
  }
}
