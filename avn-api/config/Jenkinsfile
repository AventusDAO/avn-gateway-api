                        //             }
                        //         }
                                // stage('Gateway Api: Awt Test') {
                                //     catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                //         sh "npm run awtTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT} --reporter mochawesome --reporter-options reportDir=reportDir,reportFilename=awtReport;"
                                //     }
                                // }
                                // stage('Gateway Api: Utils') {
                                //     catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                //         sh "npm run utilsTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT} --reporter mochawesome --reporter-options reportDir=reportDir,reportFilename=utilsReport;"
                                //     }
