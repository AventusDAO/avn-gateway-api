        string(name: 'Descriptive_name', defaultValue: '', description: 'Give a descriptive name to your test run');
    }
    stages {
        stage('Build') {
            steps {
                sh 'rm -rf node_modules'
                sh 'rm -f package-lock.json'
                sh 'npm cache clean --force'
