{
    "compilerOptions": {
      "lib": ["es5", "es6"],
      "allowJs": true,
      "target": "es5",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "resolveJsonModule": true
    },
    "include": ["./**/*"],
    "exclude": ["node_modules", "build", "config", "res"]
  }
  