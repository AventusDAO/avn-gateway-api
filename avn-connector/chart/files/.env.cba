AVN_NODE_URL: "wss://avn.cba-stargate.aventus.io/"
SERVER_PORT: "5000"

REDIS_PORT: "6379"

SM_AWS_REGION: "eu-west-1"
AVN_TX_QUEUE: "avnTx"
AVN_TX_RETRY_COUNT: "3"
AVN_TX_RESEND_DELAY: "1000"
DEAD_LETTER_QUEUE: "dlq_queue"
DEAD_LETTER_EXCHANGE: "dlx_exchange"
DEAD_LETTER_KEY: "dlx_key"

MONGO_DATABASE_NAME: "avn-gateway"
MONGO_OPTIONS: "useUnifiedTopology=true&minPoolSize=1&wtimeout=10000&useNewUrlParser=true&sslValidate=true"
