pipeline {
  environment {
    avn_connector_path = "avn-connector"
    INFURA_URL_CBA = credentials('avn_connector_infura_url_dev')
  }

  parameters {
    choice(name: 'environment', choices: ['sandbox', 'cba', 'pentest', 'testnet', 'mainnet'], description: 'Deploy to which environment?')
    choice(name: 'nodeEnv', choices: ['production', 'docker'], description: 'Represents the NODE_ENV variable in the connector. docker will use internal kubernetes services for Rabbit and Redis etc where as production will use the AWS managed resources.')
    string(name: 'image_tag', defaultValue: 'latest', description: 'Docker tag of the avn-connector', trim: true)
  }

  agent any

  stages {
    stage("Deploy avn-connector") {
      steps {
        script {
          if (params.environment == 'cba') {
            env.INFURA_URL = env.INFURA_URL_CBA
          }
        }
        withAWS(roleAccount:accountId(), role:'jenkins-access') {
          generateContext("avn-gateway", "dev")
          sh "helm template ${env.avn_connector_path}/chart --set environment=${env.environment} --set accountId=${accountId()} --set deployment.image.tag=${env.image_tag} --set nodeEnv=${env.nodeEnv} --set infura_url=${env.INFURA_URL_CBA} | kubectl apply -f -"
        }
      }
    }
    stage("Smoke test") {
      steps {
        withCredentials([string(credentialsId: "avn_gateway_suri_${env.environment}", variable: "SURI")]) {
          script {
            sh "cd avn-api && npm i && cd ../tests && npm i && cd ../ && npm i"
            sh "AVN_SURI=${SURI} npm run smokeTests ${env.environment}"
          }
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}

def generateContext(String clusterName, String namespace) {
  def id = accountId()
  sh "aws eks --region eu-west-1 update-kubeconfig --name ${clusterName}"
  sh "kubectl config set-context arn:aws:eks:eu-west-1:${id}:cluster/${clusterName} --namespace ${namespace}"
  sh "kubectl config use-context arn:aws:eks:eu-west-1:${id}:cluster/${clusterName}"
}

def accountId() {
  def environmentMap = [
    sandbox: "352429414196",
    cba: "602004642405",
    testnet: "189013141504",
    mainnet: "503742778456",
    pentest: "791662239430"
  ]
  return environmentMap[env.environment]
}
