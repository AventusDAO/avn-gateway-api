{
  "scripts": {
    "smokeTests": "mocha --timeout 100000 ./tests/gateway-smoke-tests.js",
    "apiTests": "mocha --timeout 100000 ./avn-api/tests --recursive",
    "pollTests": "mocha --timeout 100000 ./avn-api/tests/pollApiTest.js --recursive",
    "avn-connectorTests": "mocha --timeout 100000 ./avn-connector/tests --recursive",
    "lambdaTests": "mocha --timeout 60000 ./lambdas/tests --recursive",
    "allTests": "npm run apiTests && npm run avn-connectorTests && npm run lambdaTests",
    "format": "npm --prefix ./avn-api run format && npm --prefix ./avn-connector/src run format && npm --prefix ./lambdas run format"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "chai-as-promised": "7.1.1",
    "mocha": "^9.0.2"
  },
  "dependencies": {
    "child-process-async": "^1.0.1"
  }
}
