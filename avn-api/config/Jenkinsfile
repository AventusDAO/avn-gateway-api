pipeline {
    agent {
        docker { image 'node:16.13.1-alpine' }
    }
    environment {
        NPM_CONFIG_CACHE = "${WORKSPACE}/.npm"
        UAT_USER_SEED = credentials('uat_gateway_tests_user_seed')
        STARGATE_USER_SEED = credentials('sandbox_gateway_tests_user_seed')
        PUBLIC_TESTNET_USER_SEED = credentials('public_testnet_gateway_tests_user_seed')
        SECRET_UAT_ACCOUNTS_FILE = credentials('uat_avn_gateway_tests_accounts')
        SECRET_UAT_ENVIRONMENT_FILE = credentials('uat_avn_gateway_tests_environment')
        SECRET_STARGATE_ACCOUNTS_FILE = credentials('sandbox_avn_gateway_tests_accounts')
        SECRET_STARGATE_ENVIRONMENT_FILE = credentials('sandbox_avn_gateway_tests_environment')
        SECRET_PUBLIC_TESTNET_ACCOUNTS_FILE = credentials('public_testnet_avn_gateway_tests_accounts')
        SECRET_PUBLIC_TESTNET_ENVIRONMENT_FILE = credentials('public_testnet_avn_gateway_tests_environment')
        GOOGLE_DRIVE_ENVS = credentials('google_drive_credentials_test_reports');
        GOOGLE_DRIVE_CLIENT_ID = credentials('google_drive_client_id');
        GOOGLE_DRIVE_CLIENT_SECRET = credentials('google_drive_client_secret');
        GOOGLE_DRIVE_REDIRECT_URI = credentials('google_drive_redirect_uri');
        GOOGLE_DRIVE_REFRESH_TOKEN = credentials('google_drive_refresh_token');
    }
    triggers {
        cron('0 0 * * *')
    }
    parameters {
        choice(name: 'Chain', choices: ['uat', 'stargate', 'public_testnet'], description: 'Choose which chain to test')
    }
    stages {
        stage('Build') {
            steps {
                sh 'echo $GOOGLE_DRIVE_ENVS > .env'
                sh 'cat .env'
                sh 'rm -rf node_modules'
                sh 'rm -f package-lock.json'
                sh 'npm cache clean --force'
                sh 'npm install'
                sh 'npm install avn-api'
                sh 'npm install --save-dev mochawesome'
                sh 'npm install mochawesome-merge --save-dev'
                sh 'npm add dotenv googleapis'
                sh 'npm add -D @types/node'
                script {
                    if (params.Chain == 'uat') {
                        env.ACCOUNTS = env.SECRET_UAT_ACCOUNTS_FILE
                        env.ENVIRONMENT = env.SECRET_UAT_ENVIRONMENT_FILE
                        env.AVN_SURI = env.UAT_USER_SEED
                    } else if (params.Chain == 'stargate') {
                        env.ACCOUNTS = env.SECRET_STARGATE_ACCOUNTS_FILE
                        env.ENVIRONMENT = env.SECRET_STARGATE_ENVIRONMENT_FILE
                        env.AVN_SURI = env.STARGATE_USER_SEED
                    } else {
                        env.ACCOUNTS = env.SECRET_PUBLIC_TESTNET_ACCOUNTS_FILE
                        env.ENVIRONMENT = env.SECRET_PUBLIC_TESTNET_ENVIRONMENT_FILE
                        env.AVN_SURI = env.PUBLIC_TESTNET_USER_SEED
                    }
                }
            }
        }
        stage('Account Funding') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh "npm run fund ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
                }
            }
        }
        stage('Gateway Tests') {
            parallel {
                // stage('Gateway Api: Awt Test') {
                //     steps {
                //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                //             sh "npm run awtTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
                //         }
                //     }
                // }
                // stage('Gateway Api: Utils') {
                //     steps {
                //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                //             sh "npm run utilsTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
                //         }
                //     }
                // }
                stage('Gateway Api: Poll') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            sh "npm run pollApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT} --reporter mochawesome --reporter-options reportDir=reportDir,reportFilename=pollApiReport;"
                        }
                    }
                }
                // stage('Gateway Api: Query') {
                //     steps {
                //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                //             sh "npm run queryApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
                //         }
                //     }
                // }
                stage('Gateway Api: Poll Failure cases') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            sh "npm run failPollApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT} --reporter mochawesome --reporter-options reportDir=reportDir,reportFilename=failPollApiReport;"
                        }
                    }
                }
                // stage('Gateway Api: Query Failure cases') {
                //     steps {
                //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                //             sh "npm run failQueryApiTests ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
                //         }
                //     }
                // }
                // stage('Gateway Api: Send Failure cases') {
                //     steps {
                //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                //             sh "npm run failSendApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
                //         }
                //     }
                // }
            }
        }
        stage('MERGE REPORT REPORT') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    sh "npx mochawesome-merge ./reportDir/*.json -o finalReport.json"
                    sh "npx mochawesome-report-generator finalReport.json --reportDir ./ --inline"
                    sh "npm start"
                }
            }
        }
        // stage('Gateway Api: Access') {
        //     steps {
        //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        //             sh "npm run accessTests ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
        //         }
        //     }
        // }
        // stage('Gateway Api: Send') {
        //     steps {
        //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        //             sh "npm run sendApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
        //         }
        //     }
        // }
        // stage('Gateway Api: Proxy') {
        //     steps {
        //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        //             sh "npm run proxyApiTest ${params.Chain} -- --accounts=${ACCOUNTS} --environment=${ENVIRONMENT};"
        //         }
        //     }
        // }
    }
}

