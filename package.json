{
  "scripts": {
    "smokeTests": "mocha --timeout 100000 ./tests/gateway-smoke-tests.js ${baselineCmd} --gateway",
    "smokeTests:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run smokeTests",
    "apiTests": "mocha --timeout 100000 'avn-api/tests/apiTests.js' --delay ${baselineCmd} --gateway",
    "apiTests:baseline": "baselineCmd=\"--invert --grep @NO_BASELINE\" npm run apiTests",
    "solo": "mocha --timeout 100000 ",
    "pretty": "prettier --config ./.prettierrc.json --check \"**/*.{js,json}\"",
    "pretty:fix": "prettier --config ./.prettierrc.json --write \"**/*.{js,json}\"",
    "format": "npm run pretty:fix",
    "generateState": "./avn-api/tools/baseStateGenerator.js --gateway"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "chai-as-promised": "7.1.1",
    "colors": "^1.4.0",
    "mocha": "^9.0.2",
    "prompt-sync": "^4.1.6",
    "serverless": "^3.1.1",
    "yargs": "^17.3.1"
  },
  "dependencies": {
    "child-process-async": "^1.0.1",
    "prettier": "^2.5.1"
  }
}
